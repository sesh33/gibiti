# Populate in your hosting provider's secure environment settings. Never commit values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
ELDORADO_CLIENT_ID=
# Optional environment alternative: the Owner can connect securely in Settings.
ELDORADO_CLIENT_SECRET=
# Explicit opt-in for local, synthetic inbox fixtures. Never enabled in production.
RIVOX_DEV_MOCKS=false
# 32-byte encryption key encoded as 64 hex characters, for internal inventory secrets.
INVENTORY_ENCRYPTION_KEY=
# Hosted worker key: configure-hosted-automation.py generates it in Vault and
# encrypted Vercel settings. Never reuse a Seller or provider administration token.
CRON_SECRET=
